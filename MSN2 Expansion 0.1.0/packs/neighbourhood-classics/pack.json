{
  "id": "neighbourhood-classics",
  "name": "Neighbourhood Classics",
  "version": "0.1.0",
  "author": "SenjuWoo",
  "minFramework": "0.1.0",
  "missions": [
    {
      "id": "nc01_old_habits",
      "title": "Old Habits",
      "giver": "The Collector",
      "description": "An anonymous big spender wants real jobs again: a client, a target, a plan. First test: Chloe, right next door.",
      "unlock": {
        "minDay": 1,
        "fromHour": 8,
        "toHour": 23
      },
      "intro": [
        {
          "speaker": "The Collector",
          "text": "Saw your little channel. Cute. Amateur, but cute."
        },
        {
          "speaker": "The Collector",
          "text": "Back in the day this was a craft. A client, a target, a plan. Let's do it properly."
        },
        {
          "speaker": "The Collector",
          "text": "Chloe. Next door. I want a photo of her inside her own house. Bring me something of hers and I pay extra."
        }
      ],
      "objectives": [
        {
          "id": "photo",
          "text": "Photograph Chloe inside her house",
          "type": "photo",
          "actor": "Chloe",
          "house": "ChloeHouse"
        }
      ],
      "bonus": [
        {
          "id": "souvenir",
          "text": "Souvenir: steal one of Chloe's hair ties",
          "type": "steal",
          "house": "ChloeHouse",
          "reward": {
            "money": 75
          },
          "item": "HairElastic",
          "spawn": true
        },
        {
          "id": "cam",
          "text": "Hide a camera in Chloe's house",
          "type": "hidden_camera",
          "house": "ChloeHouse",
          "reward": {
            "money": 75,
            "subscribers": 25
          }
        },
        {
          "id": "shadow",
          "text": "Shadow: nobody raises the alarm",
          "type": "no_alert",
          "reward": {
            "money": 100
          }
        },
        {
          "id": "timed",
          "text": "Finish within 4 hours",
          "type": "within_hours",
          "hours": 4,
          "reward": {
            "money": 50
          }
        }
      ],
      "reward": {
        "money": 250,
        "subscribers": 150
      },
      "outro": [
        {
          "speaker": "The Collector",
          "text": "Not bad. Shaky frame, but the subject is... inspiring."
        },
        {
          "speaker": "The Collector",
          "text": "Get some sleep. I'll have something wetter for you soon."
        }
      ]
    },
    {
      "id": "nc02_steam_room",
      "title": "Steam Room",
      "giver": "The Collector",
      "description": "Chloe showers like nobody's watching. Fix that.",
      "unlock": {
        "after": [
          "nc01_old_habits"
        ],
        "minDay": 1,
        "fromHour": 6,
        "toHour": 24
      },
      "intro": [
        {
          "speaker": "The Collector",
          "text": "Our girl next door takes long showers. Hot ones."
        },
        {
          "speaker": "The Collector",
          "text": "Catch her in there. Naked, wet, unaware. And I collect bathroom trinkets, if you're feeling brave."
        }
      ],
      "objectives": [
        {
          "id": "shower",
          "text": "Photograph Chloe in the shower",
          "type": "photo",
          "actor": "Chloe",
          "activity": "Shower"
        }
      ],
      "bonus": [
        {
          "id": "naked",
          "text": "Make sure she's naked in the shot",
          "type": "photo",
          "actor": "Chloe",
          "naked": true,
          "reward": {
            "money": 100,
            "subscribers": 50
          }
        },
        {
          "id": "souvenir",
          "text": "Souvenir: steal Chloe's toothbrush",
          "type": "steal",
          "item": "Toothbrush",
          "house": "ChloeHouse",
          "reward": {
            "money": 75
          },
          "spawn": true
        },
        {
          "id": "shadow",
          "text": "Shadow: nobody raises the alarm",
          "type": "no_alert",
          "reward": {
            "money": 100
          }
        }
      ],
      "reward": {
        "money": 350,
        "subscribers": 200
      },
      "outro": [
        {
          "speaker": "The Collector",
          "text": "Now THAT is content. The fog on the glass is a nice touch."
        }
      ]
    },
    {
      "id": "nc03_lady_of_the_house",
      "title": "Lady of the House",
      "giver": "The Collector",
      "description": "Emma runs a big house and keeps a tight schedule. The Collector wants eyes inside her bedroom.",
