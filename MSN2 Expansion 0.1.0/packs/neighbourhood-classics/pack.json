      "bonus": [
        {
          "id": "souvenir",
          "text": "Souvenir: steal Emma's panties",
          "type": "steal",
          "item": "Panties",
          "house": "EmmaHouse",
          "reward": {
            "money": 150
          },
          "spawn": true
        },
        {
          "id": "shadow",
          "text": "Shadow: nobody raises the alarm",
          "type": "no_alert",
          "reward": {
            "money": 125
          }
        },
        {
          "id": "timed",
          "text": "Finish within 6 hours",
          "type": "within_hours",
          "hours": 6,
          "reward": {
            "money": 75
          }
        }
      ],
      "reward": {
        "money": 500,
        "subscribers": 300
      },
      "outro": [
        {
          "speaker": "The Collector",
          "text": "Silk sheets. Of course. You're getting good at this."
        }
      ]
    },
    {
      "id": "nc04_caught",
      "title": "Caught in the Act",
      "giver": "The Collector",
      "description": "Traps, bait, patience. Catch one of the neighbours and get the money shot while she's stuck.",
      "unlock": {
        "after": [
          "nc03_lady_of_the_house"
        ],
        "minDay": 3,
        "fromHour": 6,
        "toHour": 24
      },
      "intro": [
        {
          "speaker": "The Collector",
          "text": "Time to get your hands dirty. Set a trap, let one of them walk into it."
        },
        {
          "speaker": "The Collector",
          "text": "Then a photo while she's stuck and helpless. Here's a bucket on the house."
        }
      ],
      "objectives": [
        {
          "id": "trap",
          "text": "Catch a neighbour in a trap",
          "type": "trap"
        },
        {
          "id": "photo",
          "text": "Photograph her while she's trapped",
          "type": "photo",
          "activity": "Trapped"
        }
      ],
      "bonus": [
        {
          "id": "bucket",
          "text": "Use a bucket trap",
          "type": "trap",
          "trap": "Bucket",
          "reward": {
            "money": 100
          }
        },
        {
          "id": "shadow",
          "text": "Shadow: nobody raises the alarm",
          "type": "no_alert",
          "reward": {
            "money": 150
          }
        }
      ],
      "reward": {
        "money": 600,
        "subscribers": 400,
        "items": {
          "BucketTrap": 1,
          "Aphrodisiac": 1
        }
      },
      "outro": [
        {
          "speaker": "The Collector",
          "text": "Beautiful. Helpless looks good on her. There's a little spray in the package. You know what it's for."
        }
      ]
    },
    {
      "id": "nc05_red_room",
      "title": "The Red Room",
      "giver": "The Collector",
