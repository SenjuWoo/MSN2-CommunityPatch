      "intro": [
        {
          "speaker": "The Collector",
          "text": "Emma. Rich husband, big house, bored eyes."
        },
        {
          "speaker": "The Collector",
          "text": "I want her bedroom on camera and a picture of her in it. Panties, if you can find them, pay double."
        }
      ],
      "objectives": [
        {
          "id": "cam",
          "text": "Hide a camera in Emma's bedroom",
          "type": "hidden_camera",
